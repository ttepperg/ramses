! COMPILE CODE WITH: Makefile_3D_GNU_OLDMPI0_DICEMULTIPATCH_GAS
!
! ICs created with my AGAMA + gas framework
!
! MAKE SURE to set the correct path to the ICs (initfile)
!
! This NML file is a copy of (adapted to the updated Ramses NML conventions):
!
! /Users/tepper/codes/ramses_020217/ramses/trunk/ramses/patch/mySIMS/Nbody+HD/dice/myics/dice_dmhalo_ghalo/setup/dice_dmhalo_ghalo_c.nml
!
! and is completely different from dice_dmhalo_ghalo_c.nml_bck (despite the similar name)
! The intent is to recreate model dice_dmhalo_ghalo_c with AGAMA+gas rather than DICE
!
! NOTE THAT the mass scaling gadget_scale_m is different between DICE and AGAMA by a factor of 1e10


&RUN_PARAMS
print_when_io=.true.
verbose=.false.
cosmo=.false.
hydro=.true.
pic=.true.
poisson=.true.
nrestart=0
nremap=10
nsubcycle=7*1
ncontrol=1
/

! Note that these differ from my usual settings and will affect the value of the time unit, prompting changes to OUTPUT_PARAMS
&UNITS_PARAMS
units_density = 1.6727d-24 ! 1 H / cm^3
units_time    = 0.470430312423675E+15 ! G=1 -> 14.9 Myr
units_length  = 0.308567758128200E+22 ! 1 kpc
/

&COOLING_PARAMS
cooling=.true.
/

&SF_PARAMS
jeans_ncells=8
/

&HYDRO_PARAMS
gamma=1.667d0
courant_factor=0.5
slope_type=3
scheme='muscl'
riemann='hllc'
pressure_fix=.true.
beta_fix=0.5d0
/

&POISSON_PARAMS
gravity_type=0
cic_levelmax=11	! IMORTANT TO AVOID N-BODY RELAXATION EFFECTS
/

&AMR_PARAMS
boxlen=5.0d2
levelmin=7
levelmax=13
ngridmax=500000
npartmax=2200000
nexpand=1
/

&REFINE_PARAMS
!jeans_refine=6*4
mass_sph=1.0d-3
m_refine=6*40		! IMORTANT TO AVOID N-BODY RELAXATION EFFECTS
interpol_type=0   ! set to 0 when restarted from output 610 to overcome T -> inf and dt -> 0; used default (1) before that
interpol_var=1    ! use this to avoid refinement runaway
/

&BOUNDARY_PARAMS
nboundary=6
bound_type= 2, 2,  2,  2,  2,  2
ibound_min=-1, 1, -1, -1, -1, -1
ibound_max=-1, 1,  1,  1,  1,  1
jbound_min= 0, 0, -1,  1, -1, -1
jbound_max= 0, 0, -1,  1,  1,  1
kbound_min= 0, 0,  0,  0, -1,  1
kbound_max= 0, 0,  0,  0, -1,  1
no_inflow=.false.
/

&INIT_PARAMS
filetype='dice'
!initfile(1)='/g/data/aa8/ttg562/dice_dmhalo_ghalo_c/ic/'
initfile(1)='/import/photon2/tepper/dice_dmhalo_ghalo_c/ic/'
!initfile(1)='/project/GalSims/dice_dmhalo_ghalo_c/ic/'
/

&DICE_PARAMS
ic_file='dice_dmhalo_ghalo_c_proc.g2'        ! Name of the initial conditions file
ic_nfile=1                    ! If greater than one, look for files with name matching ic_file//'.n'
ic_ifout=1                    ! Change ramses output index for restarts
ic_format='Gadget2'           ! Format of the initial conditions. 'Gadget1' or 'Gadget2'
ic_center=0.0,0.0,0.0         ! Shift center parameter. ICs are automatically shifted with boxlen/2
ic_scale_pos=1.0              ! Scaling factor for the position vector
ic_scale_vel=1.0              ! Scaling factor for the velocity vector
ic_scale_mass=1.0             ! Scaling factor for the mass
ic_scale_u=1.0                ! Scaling factor for the internal energy
ic_scale_age=1.0              ! Scaling factor for the particles age
ic_scale_metal=1.0            ! Scaling factor for the metallicity
ic_head_name='HEAD'           ! Name of the Header datablock (Gadget2 format only)
ic_pos_name='POS '            ! Name of the position vector datablock (Gadget2 format only)
ic_vel_name='VEL '            ! Name of the velocity vector datablock (Gadget2 format only)
ic_mass_name='MASS'           ! Name of the mass datablock (Gadget2 format only)
ic_id_name='ID  '             ! Name of the particle identifier datablock (Gadget2 format only)
ic_u_name='U   '              ! Name of the internal energy datablock (Gadget2 format only)
ic_metal_name='Z   '          ! Name of the metallicity datablock (Gadget2 format only)
ic_age_name='AGE '            ! Name of the particle age datablock (Gadget2 format only)
IG_rho=5.4D-6                 ! Intergalactic gas density (defaults to 1.0d-5); the adopted value is ~rho at the halo's edge
IG_T2=6.8D5                   ! Intergalactic gas temperature (defaults to 1.0d7); SHOULD be T - 4.5e5 at the halo's edge
IG_metal=0.0D0                 ! Intergalactic gas metallicity (defaults to 1.0d-2)
amr_struct=.false.            ! Reproduce the AMR structure of the Gadget2 file resulting from a ramses to gadget conversion
gadget_scale_l=3.085677581282D+21	! Gadget file length unit   -> 1 kpc
gadget_scale_v=1.0D+5 				! Gadget file velocity unit -> 1 km/s
gadget_scale_m=1.9891D+43			! Gadget file mass unit     -> 1 solar mass
gadget_scale_t=3.15360D+13			! Gadget file time unit    -> 1 Myr (note that this is NOT the simulation time unit)
ic_skip_type        = -1      ! Exclude specific particle type
cosmo_add_gas_index = -1      ! Gas particle type index for cosmo runs
ic_mag_const=0.0,0.0,0.0      ! Background magnetic field value for x,y,z component
ic_mag_center_x=0.0           ! x-coordinate of the magnetic field symmetry center
ic_mag_center_y=0.0           ! y-coordinate of the magnetic field symmetry center
ic_mag_center_z=0.0           ! z-coordinate of the magnetic field symmetry center
ic_mag_axis_x=0.0             ! Magnetic field normal vector x-component
ic_mag_axis_y=0.0             ! Magnetic field normal vector y-component
ic_mag_axis_z=1.0             ! Magnetic field normal vector z-component
ic_mag_scale_R=1.0            ! Toroidal magnetic field scalelength
ic_mag_scale_H=1.0            ! Toroidal magnetic field scaleheight
ic_mag_scale_B=0.0            ! Foreground toroidal magnetic field value
/

&OUTPUT_PARAMS
!tend = 50.
tend = 100.
delta_tout = 0.1
!noutput=1
!tout=50.
!foutput=100
!output_dir='/g/data/aa8/ttg562/dice_dmhalo_ghalo_c/'
output_dir='/import/photon2/tepper/dice_dmhalo_ghalo_c/'
!output_dir='/project/GalSims/dice_dmhalo_ghalo_c/'
/
