! COMPILE CODE WITH:
! make -f Makefile_3D_GNU_OLDMPI0_DICE_RESTARTMULTIPATCH_GAS
!
! Modified copy of hbd_11_gd0_new.nml
!
! Allows to:
!  - Change number of cores at restart for an N-body/HYDRO
! simulation WITHOUT galaxy formation physics (star formation, feedback)
!  - Load *additional* DICE ICs at restart

! For a normal run comment out RESTART_PARAMS and set:
!	- nrestart = 0 in RUN_PARAMS
!	- filetype='dice' in INIT_PARAMS
!
! For a normal restart comment out RESTART_PARAMS and set:
!	- nrestart = 0 in RUN_PARAMS
!
! For a restart to change number of cores uncomment RESTART_PARAMS
! and set:
!	- nrestart = 0 in RUN_PARAMS
!	- nrestart2 > 0 in RESTART_PARAMS
!	- filetype='ramses_dice' in INIT_PARAMS


&RUN_PARAMS
print_when_io=.true.
verbose=.false.
cosmo=.false.
hydro=.true.
pic=.true.
poisson=.true.
nrestart=0
nremap=10
nsubcycle=7*1
ncontrol=1
/


&UNITS_PARAMS
units_density = 1.6605390D-24			! g/cm^3 = 1 H / cm^3;	 Ramses unit
units_time    = 3.00386047142391D+15 	! s; -> G=1; needed if poisson=.true.
units_length  = 3.0856776D+21 			! cm = 1 kpc;	Ramses unit
/


&COOLING_PARAMS
!cooling=.true.
isothermal=.true.
!haardt_madau=.false. 		!-> default => Nmodel=2 Theuns+98 cool.mod. (theuns=.true.)
!J21=0.1d0					!-> default => Theuns+98 UV background model
!a_spec=1.0d0				!-> default => Theuns+98 UV background model
!z_ave=0.1					!-> default 0; rel. to 0.02 (solar); see e.g. hydro/init_flow_fine.f90:268 and dice/init_part.f90/1328; requires metal=.true. and star=.true. -> not sure about the latter...
!metal=.true.				!-> metallicity affects cooling!
/


&SF_PARAMS
T2_star=1.0d4	!-> defines a temperature floor -> keep the gas disc stable
g_star=1.0d0    !-> defines a temperature floor -> keep the gas disc stable
n_star=1.0d0	!-> defines a temperature floor -> keep the gas disc stable
/


&HYDRO_PARAMS
smallr=1.0d-20			! may not have an effect due to IG_rho (see DICE_PARAMS)
gamma=1.667d0			! make sure it is identical to value in AGAMA preproc
courant_factor=0.5
slope_type=1
scheme='muscl'
riemann='llf'
pressure_fix=.true.
beta_fix=0.5d0
/


&POISSON_PARAMS
gravity_type=0
/


! Memory management PER CORE (N-body+HD runs)
! ~ 0.8*[ 2*(ngridmax/10^6) + (npartmax/10^7) ] GB
! The ICs used here (DICE_PARAMS) have roughly 3.5 million particles
! Note that the more cores, the smaller ngridmax and npartmax can be
&AMR_PARAMS
boxlen=6.0d2
levelmin=8
levelmax=14
ngridmax=200000 !5000000   ! was 200000
npartmax=3000000
nexpand=1
/


&REFINE_PARAMS
jeans_refine=7*4
mass_sph=2.5d-3   		!-> refinement runaway w/o interpolation scheme below
m_refine=7*25			! had 7*40 before
interpol_type=0   		! use this to avoid refinement runaway
interpol_var=1    		! use this to avoid refinement runaway
/


&BOUNDARY_PARAMS
nboundary=6
bound_type= 2, 2,  2,  2,  2,  2 ! zero-gradient BCs ...
ibound_min=-1, 1, -1, -1, -1, -1
ibound_max=-1, 1,  1,  1,  1,  1
jbound_min= 0, 0, -1,  1, -1, -1
jbound_max= 0, 0, -1,  1,  1,  1
kbound_min= 0, 0,  0,  0, -1,  1
kbound_max= 0, 0,  0,  0, -1,  1
no_inflow=.false.				  ! ...  with inflow
/


&INIT_PARAMS
filetype='ramses_dice'
!filetype='dice'
initfile(1)='/import/photon2/tepper/dice_restart_gas/ic/'
!initfile(1)='/scratch/dr86/ttg562/dice_restart_gas/ic/'
/


! The followong block must be commented out if filetype != 'ramses_dice'
&RESTART_PARAMS
nrestart2=3
!add_dice_ic=.true.	! optional, to load additional DICE ICs at restart
restart_vars=6   	!-> corresponds to actual indices of passive scalars
/


&DICE_PARAMS
ic_file='hbd_11_gd0_new_proc.g2'           ! Name of the initial conditions file
ic_nfile=4                    ! If greater than one, look for files with name matching ic_file//'.n'
ic_ifout=1                    ! Change ramses output index for restarts
ic_format='Gadget2'           ! Format of the initial conditions. 'Gadget1' or 'Gadget2'
ic_center=0.0,0.0,0.0         ! Shift center parameter. ICs are automatically shifted with boxlen/2
ic_scale_pos=1.0              ! Scaling factor for the position vector
ic_scale_vel=1.0              ! Scaling factor for the velocity vector
ic_scale_mass=1.0             ! Scaling factor for the mass
ic_scale_u=1.0                ! Scaling factor for the internal energy
ic_scale_age=1.0              ! Scaling factor for the particles age
ic_scale_metal=0.02           ! Scaling factor for the metallicity (DICE adopts solar units, RAMSES expects actual metal mass frac.)
ic_head_name='HEAD'           ! Name of the Header datablock (Gadget2 format only)
ic_pos_name='POS '            ! Name of the position vector datablock (Gadget2 format only)
ic_vel_name='VEL '            ! Name of the velocity vector datablock (Gadget2 format only)
ic_mass_name='MASS'           ! Name of the mass datablock (Gadget2 format only)
ic_id_name='ID  '             ! Name of the particle identifier datablock (Gadget2 format only)
ic_u_name='U   '              ! Name of the internal energy datablock (Gadget2 format only)
ic_metal_name='Z   '          ! Name of the metallicity datablock (Gadget2 format only)
ic_age_name='AGE '            ! Name of the particle age datablock (Gadget2 format only)
IG_rho=1.0D-15                 ! IGM gas density (default 1.0d-5)
IG_T2=1.0D4                   ! IGM gas temperature (default: 1.0d7)
IG_metal=0.0                  ! IGM metallicity (defaul:t 1.0d-2)
amr_struct=.false.            ! Reproduce the AMR structure of the Gadget2 file resulting from a ramses to gadget conversion
gadget_scale_l=3.085677581282D+21	! AGAMA file length unit   -> 1 kpc
gadget_scale_v=1.0D+5 				! AGAMA file velocity unit -> 1 km/s
gadget_scale_m=1.9891D+33			! AGAMA file mass unit     -> 1 solar mass
gadget_scale_t=3.15360D+13			! Gadget file time unit    -> 1 Myr (note that this is NOT the simulation time unit)
/


&OUTPUT_PARAMS
tend = 45.
delta_tout = 2e-3 !0.1
output_dir='/import/photon2/tepper/dice_restart_gas/'
!output_dir='/scratch/dr86/ttg562/dice_restart_gas/'
/
