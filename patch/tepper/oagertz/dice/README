    init_part.f90:
    14 relevant difference(s) with respect to my patched dice version
    - all if-clauses of the form:
        if(star.or.sink)then
            ...
        endif
        if(metal)then
        endif
    nested into:
        if(star.or.sink)then
            if(metal)then
            endif
        endif
    - added
        use hydro_parameters,only: nmetals ! ERIC
    - added
        integer :: imet ! ERIC
    - added allocation
        allocate(itmpp (npartmax))
    - added allocation / initialisation
        allocate(mpb(npartmax))
        mpb=0.0
    - added allocation / initialisation
        allocate(zp(npartmax,nmetals)) ! ERIC
        zp=0.0
    - added read
        zp(1:npart2,imet)=xdp
    - added read
        mpb(1:npart2)=xdp
    - added initialisation
        zp(ipart,imet)=0d0
    - modified assignment of metallicity
    ! zp(ipart)  = zz(i)
        zp(ipart,1)  = ic_scale_metalFe * zz(i) !Iron
        zp(ipart,2)  = ic_scale_metalO  * zz(i) !Oxygen
    and
        zp(ipart+1,1:nmetals)  = z_ave*0.02 ! TTG
    where relevant

    - init_flow_fine.f90:
    8 relevant difference(s) with respect to my patched dice version
    - replaced in init_uold()
        if(metal) then
          if(ivar.eq.imetal) uold(active(ilevel)%igrid(i)+iskip,ivar) = max(IG_rho/scale_nH,smallr)*IG_metal*ic_scale_metal
        endif
    by
        if(star.or.sink)then
           ! ERIC
           if(metal) then
             ! Iron
             if(ivar.eq.imetal) &
             & uold(active(ilevel)%igrid(i)+iskip,ivar) = &
             & ic_scale_metalFe * max(IG_rho/scale_nH,smallr) * IG_metal * ic_scale_metal
             ! Oxygen
             if(ivar.eq.imetal+1) &
             & uold(active(ilevel)%igrid(i)+iskip,ivar) = &
             & ic_scale_metalO * max(IG_rho/scale_nH,smallr) * IG_metal * ic_scale_metal
           endif
        endif
    - added to surbroutine init_gas_cic()
        integer:: imet ! ERIC
    - replaced in soubroutine init_gas_cic()
        if(metal) then
          uold(indp(j,ind),imetal)=uold(indp(j,ind),imetal)+mp(ind_part(j))*vol(j,ind)/vol_loc(j)*zp(ind_part(j))
        endif
    by
        if(star.or.sink)then
           if(metal) then
              ! ERIC
              do imet=1,nmetals
                 uold(indp(j,ind),imetal+imet-1) = uold(indp(j,ind),imetal+imet-1) + mp(ind_part(j))*vol(j,ind)/vol_loc(j)*zp(ind_part(j),imet)
              enddo
           endif
        endif
    - added in subroutine init_gas_ngp()
        integer:: imet ! ERIC
    - replaced in subroutine init_gas_ngp()
        if(metal) then
           uold(indp(j),imetal)=uold(indp(j),imetal)+mp(ind_part(j))/vol_loc(j)*zp(ind_part(j))
        endif
    by
        if(star.or.sink)then
           if(metal) then
           ! ERIC
              do imet=1,nmetals
                  uold(indp(j),imetal+imet-1) = uold(indp(j),imetal+imet+1) + mp(ind_part(j))/vol_loc(j)*zp(ind_part(j),imet)
              enddo
           endif
        endif

