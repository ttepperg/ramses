          #ifdef LIGHT_MPI_COMM
                  reception(icpu,ilevel)%pcomm%u(current_property,ind_com(i))=mpb(ind_part(i))
          #else
                  reception(icpu,ilevel)%up(ind_com(i),current_property)=mpb(ind_part(i))
          #endif
